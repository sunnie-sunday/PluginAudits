root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

[packages.lock.json]
indent_style = space
indent_size = 2

[*.cs]
max_line_length = 120
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion

[*.md]
indent_style = space

[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
